+def test_authorization_diagnostic_keeps_concurrent_fixture_clocks_separate():
+    diagnostics, barrier, clocks = FixtureAuthorizationDiagnostics(), threading.Barrier(2), []
+    class Verifier:
+        def __init__(self, value): self.clock = lambda: value
